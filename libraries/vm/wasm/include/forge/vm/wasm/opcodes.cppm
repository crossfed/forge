       FORGE_VM_WASM_CONTROL_FLOW_OPS(FORGE_VM_WASM_CREATE_MAP) FORGE_VM_WASM_BR_TABLE_OP(FORGE_VM_WASM_CREATE_MAP)
           FORGE_VM_WASM_RETURN_OP(FORGE_VM_WASM_CREATE_MAP) FORGE_VM_WASM_CALL_OPS(FORGE_VM_WASM_CREATE_MAP)
