    variant<FORGE_VM_WASM_CONTROL_FLOW_OPS(FORGE_VM_WASM_IDENTITY) FORGE_VM_WASM_BR_TABLE_OP(FORGE_VM_WASM_IDENTITY)
                FORGE_VM_WASM_RETURN_OP(FORGE_VM_WASM_IDENTITY) FORGE_VM_WASM_CALL_OPS(FORGE_VM_WASM_IDENTITY)
                    FORGE_VM_WASM_CALL_IMM_OPS(FORGE_VM_WASM_IDENTITY) FORGE_VM_WASM_PARAMETRIC_OPS(
