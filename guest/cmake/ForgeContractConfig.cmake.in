@PACKAGE_INIT@

set(ForgeContract_VERSION "@PROJECT_VERSION@")
set(ForgeContract_PROFILE "@FORGE_CONTRACT_PROFILE@")
set(ForgeContract_REPRODUCIBLE "@FORGE_CONTRACT_REPRODUCIBLE@")
set(ForgeContract_LLVM_VERSION "@FORGE_CONTRACT_LLVM_TAG@")
set(ForgeContract_LLVM_COMMIT "@FORGE_CONTRACT_LLVM_COMMIT@")
set(ForgeContract_SYSROOT_SCHEMA_VERSION "@FORGE_CONTRACT_SYSROOT_SCHEMA_VERSION@")
set(ForgeContract_INTRINSIC_VERSION "@FORGE_CONTRACT_INTRINSIC_VERSION@")

get_filename_component(_forge_contract_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
set(ForgeContract_CLANG "${_forge_contract_prefix}/bin/clang++")
set(ForgeContract_WASM_LD "${_forge_contract_prefix}/bin/wasm-ld")
set(ForgeContract_SYSROOT "${_forge_contract_prefix}/sysroot")
set(ForgeContract_DATA_DIR "${_forge_contract_prefix}/@CMAKE_INSTALL_DATADIR@/forge-contract")
file(READ "${ForgeContract_DATA_DIR}/sysroot.sha256" ForgeContract_SYSROOT_HASH)
string(STRIP "${ForgeContract_SYSROOT_HASH}" ForgeContract_SYSROOT_HASH)
set(ForgeContract_TOOLCHAIN "${CMAKE_CURRENT_LIST_DIR}/ForgeContractToolchain.cmake")
set(ForgeContract_ABIGEN "${_forge_contract_prefix}/bin/abigen")
set(ForgeContract_ATTR_PLUGIN "${_forge_contract_prefix}/@CMAKE_INSTALL_LIBDIR@/forge-contract/attr-plugin@CMAKE_SHARED_MODULE_SUFFIX@")
set(ForgeContract_CHECK "${_forge_contract_prefix}/bin/contract-check")
set(ForgeContract_MANIFEST "${_forge_contract_prefix}/bin/contract-manifest")

include("${CMAKE_CURRENT_LIST_DIR}/ForgeContractFunctions.cmake")

foreach(_required
   ForgeContract_CLANG
   ForgeContract_WASM_LD
   ForgeContract_SYSROOT
   ForgeContract_DATA_DIR
   ForgeContract_ABIGEN
   ForgeContract_ATTR_PLUGIN
   ForgeContract_CHECK
   ForgeContract_MANIFEST
)
   if(NOT EXISTS "${${_required}}")
      set(ForgeContract_FOUND FALSE)
      set(ForgeContract_NOT_FOUND_MESSAGE "Forge Contract SDK is incomplete: ${${_required}} does not exist")
      return()
   endif()
endforeach()
